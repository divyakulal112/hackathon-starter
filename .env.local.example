# KisanSync — data source configuration.
#
# Default (no .env.local needed): pure localStorage demo, exactly as before.
#
# Supabase mode: set URL + anon key and NEXT_PUBLIC_DATA_SOURCE=supabase,
# then restart the dev server.
#
# Copy to .env.local and fill in:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional override. "local" forces the localStorage demo even when Supabase
# creds exist; "supabase" uses Supabase whenever creds are present.
NEXT_PUBLIC_DATA_SOURCE=local
